# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aquavista

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@aquavista.dev
EMAIL_FROM_NAME=AquaVista

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Token expiry
ACTIVATION_TOKEN_EXPIRES_HOURS=168
RESET_TOKEN_EXPIRES_HOURS=1

# AVA (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Usage limits
DEFAULT_DAILY_QUESTION_LIMIT=100
