# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (defaults to localhost:3000 in dev, aqua-vista-fe.vercel.app in prod)
# CORS_ORIGIN=https://aqua-vista-fe.vercel.app,https://staging.aqua-vista-fe.vercel.app

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aquavista

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Email (Gmail - use an App Password, not your Google password)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_PORT=587
EMAIL_FROM_NAME=AquaVista

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Token expiry
ACTIVATION_TOKEN_EXPIRES_HOURS=168
RESET_TOKEN_EXPIRES_HOURS=1

# AVA (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Usage limits
DEFAULT_DAILY_QUESTION_LIMIT=100
