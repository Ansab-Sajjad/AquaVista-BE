{
  "name": "aquavista-be",
  "version": "1.0.0",
  "description": "AquaVista Backend API — Node.js/Express/MongoDB",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "seed:admin": "ts-node src/scripts/seed-admin.ts",
    "seed:templates": "ts-node src/scripts/seed-templates.ts",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testTimeout": 60000
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.3.1",
    "express-validator": "7.3.2",
    "google-auth-library": "^11.0.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.1",
    "morgan": "1.11.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.0",
    "winston": "3.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.6",
    "@types/morgan": "1.9.9",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "eslint": "9.29.0",
    "fast-check": "^3.22.0",
    "globals": "17.5.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.4",
    "typescript-eslint": "8.58.2"
  }
}
